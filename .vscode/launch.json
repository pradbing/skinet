    "version": "0.2.0",
    "configurations": [ 

        {
            "name": "C#: API Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/API/API.csproj"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "preLaunchTask": "build"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "https://localhost:4200",
            "webRoot": "${workspaceFolder}/Client/"
        }

    ],
  "compounds": [
    {
      "name": "Full Stack Debug",
      "configurations": ["C#: API Debug",".NET Core Attach","Launch Chrome against localhost"]
    }
  ]
}